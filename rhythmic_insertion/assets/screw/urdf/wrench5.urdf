<?xml version="1.0"?>
<robot name="wrench5">
    <link name="wrench">
        <visual>
            <geometry>
                <mesh filename="../mesh/wrench/wrench5.obj" scale="1 1 1"/>
            </geometry>
            <material name="Red">
                <color rgba="1.0 0 0 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="../mesh/wrench/wrench5.obj" scale="1 1 1"/>
            </geometry>
            <sdf resolution="512"/>
        </collision>
    </link>
    <!-- Used for calculating the wrench head pose -->
    <joint name="wrench_head_joint" type="fixed">
        <parent link="wrench"/>
        <child link="wrench_head"/>
        <origin rpy="1.5707963267948966 -1.5707963267948966 0.33161255" xyz="0.01063523 -0.14118812  0.        "/> <!-- (0.03 x sin(19), -0.101297 - 0.03 x cos(19), 0) -->
    </joint>
    <link name="wrench_head"/>
</robot>